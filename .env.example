# Development tanpa Docker. Salin ke backend/.env lalu sesuaikan host service lokal.
APP_ENV=development
DEMO_MODE=true
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=FinGraph QRIS API
API_VERSION=v1
ENABLE_API_DOCS=true
ENABLE_DEMO_ENDPOINTS=true
PUBLIC_REGISTRATION_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fingraph_qris
POSTGRES_USER=fingraph_qris
POSTGRES_PASSWORD=fingraph_qris_local_password
DATABASE_URL=postgresql+psycopg2://fingraph_qris:fingraph_qris_local_password@localhost:5432/fingraph_qris

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fingraph_neo4j_password
NEO4J_REQUIRED=false
NEO4J_CONNECTION_TIMEOUT_SECONDS=3
NEO4J_MAX_RETRY_SECONDS=3

JWT_SECRET_KEY=development-only-jwt-secret-never-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PJP_SIMULATOR_SECRET=development-only-pjp-secret-never-use-in-production
PJP_SIMULATOR_NAME=TrustPay Sandbox
PAYER_PSEUDONYM_KEY=development-only-payer-key-never-use-in-production
QRIS_DEMO_MODE=true
QRIS_WEBHOOK_TOLERANCE_SECONDS=300
QRIS_DEFAULT_CURRENCY=IDR
QRIS_ALERT_MIN_SCORE=0.40
QRIS_LOW_THRESHOLD=0.40
QRIS_HIGH_THRESHOLD=0.70

ML_ARTIFACT_DIR=./app/ml/artifacts
ML_ARTIFACT_SIGNING_KEY=development-only-artifact-signing-key
QRIS_GNN_DATA_DIR=/app/data/raw/qris
QRIS_GNN_HOST_DATA_DIR=./backend/data/raw/qris
QRIS_GNN_ENABLED=true
QRIS_GNN_BLEND_WEIGHT=0.50
QRIS_GNN_MAX_NODES=500
ADAPTIVE_RETRAIN_MIN_LABELS=5
ADAPTIVE_RETRAIN_LIMIT_ROWS=200000
QRIS_ADAPTIVE_MIN_LABELS=10
AUTO_MIGRATE=false
AUTO_SEED=false
SEED_GRAPH_SYNC=false

# Frontend development uses /api/v1 and Next.js proxies to this internal URL.
INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_MODE=true
