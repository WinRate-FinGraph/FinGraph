# Salin ke .env.production dan ganti SEMUA nilai REPLACE_*. File .env.production diabaikan Git.
APP_ENV=production
DEMO_MODE=false
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=FinGraph QRIS API
API_VERSION=v1
ENABLE_API_DOCS=false
ENABLE_DEMO_ENDPOINTS=false
PUBLIC_REGISTRATION_ENABLED=false
TRUSTED_HOSTS=qris.example.com
BACKEND_CORS_ORIGINS=https://qris.example.com

POSTGRES_DB=fingraph_qris
POSTGRES_USER=fingraph_qris
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_POSTGRES_SECRET
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_NEO4J_SECRET
NEO4J_REQUIRED=false
NEO4J_CONNECTION_TIMEOUT_SECONDS=3
NEO4J_MAX_RETRY_SECONDS=3

JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_JWT_SECRET_MINIMUM_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PJP_SIMULATOR_SECRET=REPLACE_WITH_DISABLED_SIMULATOR_SECRET_NOT_USED_PUBLICLY
PJP_SIMULATOR_NAME=Disabled Simulator
PAYER_PSEUDONYM_KEY=REPLACE_WITH_OPENSSL_RANDOM_PSEUDONYM_SECRET
QRIS_DEMO_MODE=false
QRIS_WEBHOOK_TOLERANCE_SECONDS=300
QRIS_DEFAULT_CURRENCY=IDR

ML_ARTIFACT_DIR=/app/ml-artifacts
ML_ARTIFACT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RANDOM_ARTIFACT_SIGNING_SECRET
QRIS_GNN_DATA_DIR=/app/data/raw/qris
QRIS_GNN_HOST_DATA_DIR=./backend/data/raw/qris
QRIS_GNN_ENABLED=false
QRIS_GNN_BLEND_WEIGHT=0.50
QRIS_GNN_MAX_NODES=500
ADAPTIVE_RETRAIN_MIN_LABELS=20
ADAPTIVE_RETRAIN_LIMIT_ROWS=200000
AUTO_MIGRATE=false
AUTO_SEED=false
SEED_GRAPH_SYNC=false
# Aman untuk VPS yang sudah memiliki Nginx/Caddy pada port 80/443.
# Host proxy meneruskan domain ke http://127.0.0.1:18080.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=18080
UVICORN_WORKERS=2

# Remote-managed Cloudflare Tunnel token. Keep the real value only in .env.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Optional immutable image tags and deployment-specific volume names.
BACKEND_IMAGE=fingraph-qris-backend:latest
FRONTEND_IMAGE=fingraph-qris-frontend:latest
NEO4J_IMAGE=neo4j:5.26.28-community
POSTGRES_VOLUME_NAME=fingraph-qris-postgres-data
NEO4J_DATA_VOLUME_NAME=fingraph-qris-neo4j-data
NEO4J_LOGS_VOLUME_NAME=fingraph-qris-neo4j-logs
ML_ARTIFACT_VOLUME_NAME=fingraph-qris-ml-artifacts
