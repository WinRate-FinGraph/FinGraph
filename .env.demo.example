# Unsafe local demo defaults. Never reuse these values for staging/production.
APP_ENV=demo
DEMO_MODE=true
DEBUG=false
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
ENABLE_DEMO_ENDPOINTS=true
PUBLIC_REGISTRATION_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost

POSTGRES_DB=fingraph_qris
POSTGRES_USER=fingraph_qris
POSTGRES_PASSWORD=demo-local-postgres-password
NEO4J_USER=neo4j
NEO4J_PASSWORD=demo-local-neo4j-password
NEO4J_REQUIRED=false
NEO4J_CONNECTION_TIMEOUT_SECONDS=3
NEO4J_MAX_RETRY_SECONDS=3

JWT_SECRET_KEY=demo-local-jwt-secret-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PJP_SIMULATOR_SECRET=demo-local-pjp-secret-0123456789abcdef0123456789abcdef
PJP_SIMULATOR_NAME=TrustPay Sandbox
PAYER_PSEUDONYM_KEY=demo-local-payer-secret-0123456789abcdef0123456789abcdef
QRIS_DEMO_MODE=true
QRIS_WEBHOOK_TOLERANCE_SECONDS=300

ML_ARTIFACT_DIR=/app/ml-artifacts
ML_ARTIFACT_SIGNING_KEY=demo-local-artifact-signing-key-0123456789abcdef
AUTO_MIGRATE=false
AUTO_SEED=false
SEED_GRAPH_SYNC=false
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=80
# Named Cloudflare Tunnel token. Keep the real value only in ignored .env.
CLOUDFLARE_TUNNEL_TOKEN=
# Dependency ML cukup berat; mulai dari satu worker untuk demo lokal.
UVICORN_WORKERS=1
